# ─────────────────────────────────────────────────────────────
# CLEARFINGER — variáveis de ambiente
# Copie para .env (local) e cadastre na Vercel (Settings → Environment Variables).
# NUNCA commite valores reais.
# ─────────────────────────────────────────────────────────────

# Banco (PostgreSQL / Neon). Pooled para a aplicação, direta para migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# URL pública (sem barra final)
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# Segredo para hashes de IP — gere com: openssl rand -hex 32
AUTH_SECRET=

# Chave AES-256 dos dados do crediário (protocolo, validade, dígitos do CPF) — 64 caracteres hex.
# Gere com: openssl rand -hex 32. NÃO troque depois que houver pedidos (os dados antigos ficariam ilegíveis).
DATA_ENCRYPTION_KEY=

# Primeiro administrador (bootstrap). A senha NUNCA fica no código:
#   npm run admin:hash -- "sua-senha-forte-com-12+"
# e cole a saída (formato b64:...) abaixo. No primeiro login o usuário OWNER é criado no banco.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# BravoPay — PIX (https://bravopay.club/docs)
BRAVOPAY_API_KEY=            # bp_live_...  (Authorization: Bearer) — só no servidor
BRAVOPAY_WEBHOOK_SECRET=     # segredo do webhook deste endpoint (assinatura HMAC-SHA256)
BRAVOPAY_PRODUCT_ID=         # opcional — atribuição UTMify
BRAVOPAY_BASE_URL=           # opcional — padrão https://bravopay.club/api/v1
BRAVOPAY_MODE=               # "mock" = PIX fictício para testes (bloqueado em produção)

# Jobs (Vercel Cron + GitHub Actions): Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Meta Pixel / Conversions API
NEXT_PUBLIC_META_PIXEL_ID=   # opcional: também configurável no admin (o admin tem prioridade)
META_CAPI_TOKENS=            # pixelId:token,pixelId:token (um token por pixel) — só no servidor
META_ACCESS_TOKEN=           # alternativa: um token para todos os pixels
META_TEST_EVENT_CODE=        # opcional: código de teste do Gerenciador de Eventos
META_GRAPH_VERSION=          # opcional: padrão v21.0

# Google (também configuráveis no admin)
NEXT_PUBLIC_GA_ID=           # G-XXXXXXX
NEXT_PUBLIC_GTM_ID=          # GTM-XXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=   # AW-123456789

# Otimização de imagens da Vercel (opt-in: consome cota do plano)
IMAGE_OPTIMIZATION=
